.data
lista: .word 5, 3, 8, 1, 6
n:     .word 5
nl:    .asciiz "\n"

.text
.globl main

main:
    la $a0, lista
    lw $a1, n
    jal imprimir_lista

    li $v0, 10
    syscall

imprimir_lista:
    li $t0, 0

print_loop:
    bge $t0, $a1, end_print

    sll $t1, $t0, 2
    add $t2, $a0, $t1
    lw $a2, 0($t2)

    li $v0, 1
    move $a0, $a2
    syscall

    li $v0, 4
    la $a0, nl
    syscall

    addi $t0, $t0, 1
    j print_loop

end_print:
    jr $ra
